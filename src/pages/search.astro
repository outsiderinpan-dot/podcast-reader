---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="搜索 · Podcast Reader">
  <div class="wrap">
    <section class="hero" style="padding-bottom:0">
      <h1 style="font-size:28px">全文搜索</h1>
      <p>支持中文 / 英文 / 说话人，跨所有节目与单集。</p>
    </section>
    <input class="search-box" id="q" type="search" placeholder="输入关键词，如「主动管理」「ETF」「value investing」…" autocomplete="off" />
    <div id="results"></div>
  </div>

  <script is:inline>
    (function () {
      var INDEX = null;
      var BASE = document.documentElement.getAttribute('data-base') || '/'; // GitHub Pages 子路径
      var q = document.getElementById('q');
      var out = document.getElementById('results');
      fetch(BASE + 'search-index.json').then(function (r) { return r.json(); }).then(function (d) { INDEX = d; });

      function esc(s) { return s.replace(/[&<>]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]; }); }
      function hl(text, kw) {
        var i = text.toLowerCase().indexOf(kw.toLowerCase());
        if (i < 0) return esc(text.slice(0, 120));
        var start = Math.max(0, i - 40);
        var seg = text.slice(start, i + kw.length + 60);
        return (start > 0 ? '…' : '') + esc(seg.slice(0, i - start)) + '<mark>' + esc(seg.slice(i - start, i - start + kw.length)) + '</mark>' + esc(seg.slice(i - start + kw.length)) + '…';
      }

      function run() {
        if (!INDEX) return;
        var kw = q.value.trim();
        if (!kw) { out.innerHTML = ''; return; }
        var hits = [];
        INDEX.forEach(function (ep) {
          // 标题命中权重高
          if ((ep.title_zh + ep.title_en).toLowerCase().includes(kw.toLowerCase())) {
            hits.push({ ep: ep, score: 100, snippet: ep.title_zh + ' — ' + ep.title_en });
          }
          ep.turns.forEach(function (t) {
            if (t.zh.includes(kw) || t.en.toLowerCase().includes(kw.toLowerCase())) {
              hits.push({ ep: ep, score: 10, snippet: hl(t.zh.includes(kw) ? t.zh : t.en, kw), speaker: t.speaker });
            }
          });
        });
        // 每集最多留 3 条，按分排序
        var byEp = {};
        hits.sort(function (a, b) { return b.score - a.score; }).forEach(function (h) {
          byEp[h.ep.slug] = byEp[h.ep.slug] || [];
          if (byEp[h.ep.slug].length < 3) byEp[h.ep.slug].push(h);
        });
        var html = '';
        var count = 0;
        Object.keys(byEp).forEach(function (slug) {
          byEp[slug].forEach(function (h) {
            count++;
            html += '<a class="search-result search-hit" href="' + BASE + 'ep/' + h.ep.show + '/' + h.ep.slug + '/">' +
              '<div class="sr-title">' + esc(h.ep.title_zh) + ' <span style="color:var(--text-faint);font-weight:400;font-size:12px">' + h.ep.date + '</span></div>' +
              '<div class="sr-snippet">' + h.snippet + '</div></a>';
          });
        });
        out.innerHTML = count ? html : '<p style="color:var(--text-faint);padding:20px 0">没有匹配结果。</p>';
      }
      var timer;
      q.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(run, 150); });
    })();
  </script>
</BaseLayout>
