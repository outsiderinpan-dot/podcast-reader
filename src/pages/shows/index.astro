---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import CategorySections from '../../components/CategorySections.astro';
import Timeline from '../../components/Timeline.astro';
import { SHOWS } from '../../data/shows';
import { CATEGORIES } from '../../data/categories';
import { ALL_EPISODES } from '../../lib/episodes';

const counts: Record<string, number> = {};
for (const c of CATEGORIES) counts[c.id] = 0;
for (const s of SHOWS) {
  const id = s.category || 'other';
  counts[id] = (counts[id] || 0) + 1;
}
---
<BaseLayout title="全部节目 · Podcast Reader" description="收录的播客节目，按内容主题分类，附全站时间线">
  <div class="wrap-wide">
    <section class="hero">
      <h1>全部节目</h1>
      <p>{SHOWS.length} 档节目按内容主题分成 {CATEGORIES.length} 类。投资类做逐句中英对照，深度长谈类整理成中文长文精读。点击节目查看该节目下的全部单集，页面底部是按月份排列的全站时间线。</p>
    </section>

    <CategoryNav counts={counts} />

    <CategorySections />

    <div class="section-head" id="timeline">
      <h2 class="section-title">全站时间线</h2>
      <span class="section-note">共 {ALL_EPISODES.length} 集，按月份排列，最新在前</span>
    </div>
    <Timeline />
  </div>
</BaseLayout>
