---
import '../styles/global.css';
interface Props { title: string; description?: string; }
const { title, description = '金融播客中英精读 · 每周自动更新' } = Astro.props;
const base = import.meta.env.BASE_URL; // '/' 或 '/repo/'，用于 GitHub Pages 子路径
---
<!doctype html>
<html lang="zh-CN" data-theme="light" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="alternate" type="application/rss+xml" title="Podcast Reader RSS" href={`${base}rss.xml`} />
    <link rel="icon" type="image/svg+xml" href={`${base}icon.svg`} />
    {/* iOS/Android「添加到主屏幕」独立窗口所需 */}
    <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="精读" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <script is:inline>
      // 首屏前应用主题，避免闪烁
      (function () {
        try {
          var t = localStorage.getItem('theme') || 'light';
          document.documentElement.setAttribute('data-theme', t);
          var s = localStorage.getItem('reading-size');
          if (s) document.documentElement.style.setProperty('--reading-size', s + 'px');
          var w = localStorage.getItem('reading-width');
          if (w) document.documentElement.style.setProperty('--reading-width', w + 'px');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap-wide bar">
        <a href={base} class="brand"><span class="dot"></span>Podcast<span style="color:var(--accent)">Reader</span></a>
        <nav class="nav">
          <a href={base} data-nav="home">首页</a>
          <a href={`${base}shows/`} data-nav="shows">节目</a>
          <a href={`${base}search/`} data-nav="search">搜索</a>
          <button class="icon-btn" id="theme-btn" title="切换主题" aria-label="切换主题">☾</button>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap">
        内容版权归各播客出品方所有 · 本站为个人学习研究用途 ·
        <a href={`${base}rss.xml`}>RSS 订阅</a>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var order = ['light', 'dark', 'sepia'];
        var icons = { light: '☾', dark: '☀', sepia: '⌾' };
        var btn = document.getElementById('theme-btn');
        function apply(t) {
          document.documentElement.setAttribute('data-theme', t);
          try { localStorage.setItem('theme', t); } catch (e) {}
          if (btn) btn.textContent = icons[t] || '☾';
        }
        var cur = 'light';
        try { cur = localStorage.getItem('theme') || 'light'; } catch (e) {}
        apply(cur);
        if (btn) btn.addEventListener('click', function () {
          var next = order[(order.indexOf(document.documentElement.getAttribute('data-theme')) + 1) % order.length];
          apply(next);
        });
        // 高亮当前导航（兼容 GitHub Pages 子路径：先剥掉 base 前缀）
        var b = document.documentElement.getAttribute('data-base') || '/';
        var p = location.pathname;
        if (b !== '/' && p.indexOf(b) === 0) p = '/' + p.slice(b.length);
        document.querySelectorAll('[data-nav]').forEach(function (a) {
          var k = a.getAttribute('data-nav');
          if ((k === 'home' && p === '/') || (k === 'shows' && p.indexOf('/shows/') === 0) || (k === 'search' && p.indexOf('/search') === 0)) a.classList.add('active');
        });
      })();
    </script>
    {/* PWA：Service Worker 注册 + 轻量安装引导 */}
    <script is:inline>
      (function () {
        var b = document.documentElement.getAttribute('data-base') || '/';
        // 1) 注册 Service Worker（同源同 BASE 作用域）
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register(b + 'sw.js').catch(function (e) {
              console.warn('[pwa] SW register failed', e);
            });
          });
        }
        // 2) 已经是独立窗口运行（standalone）就不提示安装
        var standalone = window.matchMedia('(display-mode: standalone)').matches
          || window.navigator.standalone === true
          || document.referrer.indexOf('android-app://') === 0;
        if (standalone) return;
        // 3) 每用户只主动提示一次；用户手动关闭后不再打扰
        try { if (localStorage.getItem('pwa-prompt-dismissed') === '1') return; } catch (e) {}
        var isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
        var btn = null, timer = null;

        function showBar(text, actionLabel, onAction) {
          if (btn) return;
          btn = document.createElement('div');
          btn.className = 'pwa-bar';
          btn.innerHTML =
            '<div class="pwa-bar-text">' + text + '</div>' +
            '<button class="pwa-bar-act" type="button">' + actionLabel + '</button>' +
            '<button class="pwa-bar-close" type="button" aria-label="关闭">×</button>';
          document.body.appendChild(btn);
          btn.querySelector('.pwa-bar-act').addEventListener('click', onAction);
          btn.querySelector('.pwa-bar-close').addEventListener('click', function () {
            try { localStorage.setItem('pwa-prompt-dismissed', '1'); } catch (e) {}
            btn.remove(); btn = null;
          });
        }

        // 3a) Chrome/Edge/Android：等 beforeinstallprompt
        var deferred = null;
        window.addEventListener('beforeinstallprompt', function (e) {
          e.preventDefault();
          deferred = e;
          // 稍微延后，避免与首屏渲染抢焦
          clearTimeout(timer);
          timer = setTimeout(function () {
            showBar('把「精读」装到主屏幕，独立窗口 + 离线可读', '安装', function () {
              if (!deferred) return;
              deferred.prompt();
              deferred.userChoice.finally(function () {
                deferred = null;
                if (btn) { btn.remove(); btn = null; }
              });
            });
          }, 4000);
        });
        window.addEventListener('appinstalled', function () {
          if (btn) { btn.remove(); btn = null; }
        });

        // 3b) iOS Safari：无 beforeinstallprompt，提示手动路径（只提示一次）
        if (isIOS) {
          clearTimeout(timer);
          timer = setTimeout(function () {
            showBar('Safari 里点 <span class="pwa-ios-share">⎋</span> 分享 → 添加到主屏幕，即可离线阅读', '知道了', function () {
              try { localStorage.setItem('pwa-prompt-dismissed', '1'); } catch (e) {}
              if (btn) { btn.remove(); btn = null; }
            });
          }, 6000);
        }
      })();
    </script>
  </body>
</html>
